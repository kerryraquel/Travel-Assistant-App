   ];
   const pays=['Cash','Credit Card','Apple Pay','Alipay'];
   const catIcon=l=>cats.find(c=>c.label===l)?.icon||'🧾';
   
   const totalExpense = computed(() => {
     return records.value.reduce((sum, record) => sum + (Number(record.amount) || 0), 0);
   });
   
   const addRec=()=>{
     const amt = parseFloat(e.value.amount);
     if(isNaN(amt) || e.value.amount === '' || !e.value.item) return;
     records.value.unshift({
       ...e.value, 
       amount: amt, 
       id: Date.now() + Math.random().toString(36).substr(2, 9) 
     });
     localStorage.setItem('hkMoTyoRecords',JSON.stringify(records.value));
     e.value.amount=''; e.value.item='';
   };

   const delRec = (id) => {
     records.value = records.value.filter(r => r.id !== id);
     localStorage.setItem('hkMoTyoRecords',JSON.stringify(records.value));
   };
   
   onMounted(()=>{
     const saved = JSON.parse(localStorage.getItem('hkMoTyoRecords')||'[]');
     records.value = saved.map(r => {
        if(!r.id) return { ...r, id: Date.now() + Math.random().toString(36).substr(2, 9) };
