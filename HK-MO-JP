      { city: 'Tokyo', name: 'Shibuya Crossing & Sky', tag: 'Landmark', desc: 'The world\'s busiest pedestrian crossing, best viewed from the open-air Shibuya Sky observation deck at sunset.' },
      { city: 'Tokyo', name: 'Senso-ji Temple', tag: 'Culture', desc: 'Tokyo\'s oldest and most significant Buddhist temple, approached via the vibrant Nakamise shopping street.' }
   ];

   return{tab,weatherHk,weatherMo,weatherTyo,countText,days,selDay,rate,e,cats,pays,records,addRec,delRec,catIcon,totalExpense,spots,introTab,attractionDetails};
 }
}).mount('#app');
