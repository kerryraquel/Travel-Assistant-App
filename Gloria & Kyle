     { city: '上海', name: '恒基·旭輝天地', tag: '建築', desc: '讓·努維爾設計，標誌性的紅色內庭與垂直綠化，充滿法式浪漫與前衛感。' }
   ];

   // --- 記帳 ---
   const rate=ref(1.16);
   const e=ref({amount:'',item:'',cat:'餐飲',method:'支付寶'});
   const records=ref([]);
   const cats=[
     {icon:'🍜',label:'餐飲'},{icon:'🚕',label:'交通'},
     {icon:'🏨',label:'住宿'},{icon:'🎁',label:'購物'},{icon:'🎫',label:'娛樂'}
   ];
   const pays=['現金','信用卡','支付寶','微信'];
   const catIcon=l=>cats.find(c=>c.label===l)?.icon||'🧾';
   
   const addRec=()=>{
     if(!e.value.amount||!e.value.item) return;
     records.value.unshift({...e.value});
     localStorage.setItem('tripRecords',JSON.stringify(records.value));
     e.value.amount=''; e.value.item='';
   };

   // 刪除記帳功能
   const delRec = (index) => {
     if(confirm('確定要刪除這筆支出紀錄嗎？')) {
       records.value.splice(index, 1);
       localStorage.setItem('tripRecords', JSON.stringify(records.value));
     }
   };
   
   onMounted(()=>records.value=JSON.parse(localStorage.getItem('tripRecords')||'[]'));

   return{tab,weatherSz,weatherSh,countText,days,selDay,rate,e,cats,pays,records,addRec,delRec,catIcon,missedSpots,sightseeingSpots};
 }
}).mount('#app');
</script>
