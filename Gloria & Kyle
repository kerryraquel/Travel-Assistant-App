      if(code === 0) return 'fa-solid fa-sun text-orange-500';
      if([1,2,3].includes(code)) return 'fa-solid fa-cloud-sun text-slate-500';
      if([45,48].includes(code)) return 'fa-solid fa-smog text-slate-400';
      if([51,53,55,61,63,65].includes(code)) return 'fa-solid fa-cloud-rain text-blue-400';
      if(code >= 95) return 'fa-solid fa-cloud-bolt text-yellow-500';
      return 'fa-solid fa-cloud text-slate-400';
   };

